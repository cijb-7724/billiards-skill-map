{
  "name": "billiards-skill-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "build": "vite build --config vite.pages.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "test": "node scripts/validate-drills.mjs && pnpm run validate:browser-physics && pnpm run build",
    "validate:drills": "node scripts/validate-drills.mjs",
    "validate:browser-physics": "node --import tsx scripts/validate-browser-physics.ts",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "tune:r2": "node --import tsx scripts/tune-r2.ts",
    "simulate": ".venv/bin/python scripts/simulate_drills.py"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
